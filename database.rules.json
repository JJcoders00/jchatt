{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "users": {
      ".indexOn": ["email"]
    },
    "v2": {
      "handles": {
        ".indexOn": ["uid"]
      },
      "messages": {
        "$chatId": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$msgId": {
            "deliveredTo": {
              "$uid": {
                ".write": true
              }
            }
          },
          ".indexOn": ["ts"]
        }
      },
      "userChats": {
        "$uid": {
          ".read": true,
          ".write": "auth != null",
          ".indexOn": ["lastTs"]
        }
      },
      "statuses": {
        ".indexOn": ["ts"]
      },
      "calls": {
        "$uid": {
          ".indexOn": ["ts"]
        }
      },
      "pairings": {
        "$pairId": {
          ".read": true,
          ".write": "auth != null"
        }
      },
      "invites": {
        "$token": {
          ".read": true,
          ".write": "auth != null"
        }
      }
    }
  }
}
