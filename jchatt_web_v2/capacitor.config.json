{
  "appId": "com.jjcoders.jchatt",
  "appName": "Jchatt",
  "webDir": "dist",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#0b141a",
