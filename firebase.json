{
  "hosting": {
    "site": "jjcodersjchatt",
    "public": "jchatt_web_v2/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.apk"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=(self), geolocation=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/downloads/jchatt-v2.0.apk",
        "destination": "https://raw.githubusercontent.com/JJcoders00/jchatt/main/docs/Jchatt.apk",
        "type": 302
      },
      {
        "source": "/Jchatt.apk",
        "destination": "https://raw.githubusercontent.com/JJcoders00/jchatt/main/docs/Jchatt.apk",
        "type": 302
      },
      {
        "source": "/app-debug.apk",
        "destination": "https://raw.githubusercontent.com/JJcoders00/jchatt/main/docs/Jchatt.apk",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/web",
        "destination": "/web.html"
      },
      {
        "source": "/web/**",
        "destination": "/web.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/terms",
        "destination": "/terms.html"
      },
      {
        "source": "/compliance",
        "destination": "/compliance.html"
      },
      {
        "source": "/whitepaper",
        "destination": "/whitepaper.html"
      },
      {
        "source": "/honors",
        "destination": "/honors.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}